<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RoseNG.UI.Views.EncodingView">
  <StackPanel Spacing="16">
    <TextBlock Text="Encoding" Classes="pageTitle"/>
    <Border CornerRadius="16" Background="#17141A" BorderBrush="#242028" BorderThickness="1" Padding="4">
      <TabControl>
      <TabItem Header="Base64">
        <StackPanel Spacing="8" Margin="8">
          <TextBox Name="B64Input" Watermark="text or base64" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Encode" Click="B64EncodeBtn_Click"/>
            <Button Content="Decode" Click="B64DecodeBtn_Click"/>
          </StackPanel>
          <TextBox Name="B64Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="Hex">
        <StackPanel Spacing="8" Margin="8">
          <TextBox Name="HexInput" Watermark="text or hex" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Encode" Click="HexEncodeBtn_Click"/>
            <Button Content="Decode" Click="HexDecodeBtn_Click"/>
          </StackPanel>
          <TextBox Name="HexOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="JWT decoder">
        <StackPanel Spacing="8" Margin="8">
          <TextBox Name="JwtInput" Watermark="paste a JWT" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
          <Button Content="Decode" Click="JwtBtn_Click"/>
          <TextBox Name="JwtOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="220" FontFamily="monospace"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="URL">
        <StackPanel Spacing="8" Margin="8">
          <TextBox Name="UrlInput" Watermark="text or %-encoded string" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Encode" Click="UrlEncodeBtn_Click"/>
            <Button Content="Decode" Click="UrlDecodeBtn_Click"/>
          </StackPanel>
          <TextBox Name="UrlOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="ROT13">
        <StackPanel Spacing="8" Margin="8">
          <TextBox Name="Rot13Input" Watermark="text" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <Button Content="Transform" Click="Rot13Btn_Click"/>
          <TextBox Name="Rot13Output" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
        </StackPanel>
      </TabItem>
      <TabItem Header="XOR cipher">
        <StackPanel Spacing="8" Margin="8">
          <TextBox Name="XorInput" Watermark="text (encrypt) or hex (decrypt)" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
          <TextBox Name="XorKeyInput" Watermark="key"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Encrypt" Click="XorEncryptBtn_Click"/>
            <Button Content="Decrypt" Click="XorDecryptBtn_Click"/>
          </StackPanel>
          <TextBox Name="XorOutput" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="80"/>
        </StackPanel>
      </TabItem>
    </TabControl>
    </Border>
  </StackPanel>
</UserControl>
