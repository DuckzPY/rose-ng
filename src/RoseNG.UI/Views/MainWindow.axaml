<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RoseNG.UI.ViewModels"
        x:Class="RoseNG.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="rose-ng"
        Width="1100" Height="720"
        Background="#12100F">

    <Grid ColumnDefinitions="320,*" RowDefinitions="Auto,*">

        <!-- Search bar -->
        <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                 Classes="searchbar"
                 Margin="20,20,20,10"
                 Watermark="jump to a tool or paste a target..."
                 Text="{Binding SearchText}" />

        <!-- Left: tool list -->
        <ListBox Grid.Row="1" Grid.Column="0"
                 Margin="20,0,10,20"
                 Background="Transparent"
                 ItemsSource="{Binding FilteredTools}"
                 SelectedItem="{Binding SelectedTool}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ToolDescriptor">
                    <StackPanel Classes="navItem" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#F2E9E4" />
                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#9C8F8A" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Right: run panel -->
        <Border Grid.Row="1" Grid.Column="1" Classes="card" Margin="0,0,20,20">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                <TextBlock Grid.Row="0" Classes="cardTitle"
                           Text="{Binding SelectedTool.Name, FallbackValue='Select a tool'}" />
                <TextBlock Grid.Row="1" Classes="cardSubtitle" Margin="0,4,0,16"
                           Text="{Binding SelectedTool.Description}" />

                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <TextBox Grid.Column="0" Classes="searchbar"
                             Watermark="{Binding SelectedTool.InputPlaceholder}"
                             Text="{Binding ToolInput}" />
                    <Button Grid.Column="1" Margin="10,0,0,0" Padding="18,10"
                            Content="Run" Command="{Binding RunToolCommand}"
                            IsEnabled="{Binding !IsRunning}" />
                </Grid>

                <ScrollViewer Grid.Row="3">
                    <TextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" Background="#0F0D0C" BorderThickness="0"
                             FontFamily="Consolas,Menlo,monospace" FontSize="13" />
                </ScrollViewer>

                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0" Spacing="6">
                    <TextBlock Text="Need help or want to suggest a tool?" Foreground="#9C8F8A" FontSize="12" />
                    <TextBlock Text="Join the Discord" Foreground="#E38B8B" FontSize="12"
                               PointerPressed="OnDiscordLinkClicked" Cursor="Hand" />
                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>
